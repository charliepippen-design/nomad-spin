VITE_SUPABASE_URL=
# Browser client uses the anon key, or the publishable key when the anon key is unset.
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Partner IDs. Empty means not live (clean links, no affiliate params).
# Flatio partner ID. Empty: Flatio countries fall back to Booking.com.
VITE_FLATIO_ID=
# Optional override for the Booking.com aid (default is built in).
VITE_BOOKING_AID=
# Airalo Impact tracking link base, e.g. https://airalo.pxf.io/c/<publisherId>/<adId>/<campaignId>
VITE_AIRALO_TRACKING_URL=
# iVisa partner base URL (takes precedence over VITE_VISA_PARTNER_BASE_URL).
VITE_IVISA_PARTNER_BASE_URL=
VITE_VISA_PARTNER_BASE_URL=
# Skyscanner associate ID.
VITE_SKYSCANNER_ID=
# SafetyWing referral ID.
VITE_SAFETYWING_ID=
# NordVPN Impact tracking link base, e.g. https://nordvpn.sjv.io/c/<publisherId>/<adId>/<campaignId>
VITE_NORDVPN_TRACKING_URL=
